{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tobro",
  "version": "0.0.0",
  "identifier": "app.tobro",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "ui"
    },
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "tobro",
        "width": 760,
        "height": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Desktop Tor client powered by Arti",
    "longDescription": "tobro is a desktop Tor client with an embedded Arti core and a Tauri/React shell.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
