{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tobro",
  "version": "0.0.0",
  "identifier": "app.tobro",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "tobro",
        "width": 700,
        "height": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
